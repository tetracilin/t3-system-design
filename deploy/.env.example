# Copy to deploy/.env and fill in. Never commit .env.

# The address users type in the browser and in T3 Desk. No trailing slash.
PUBLIC_ORIGIN=http://nas.local:3000

# Host port published for Teable.
TEABLE_PORT=3000

# Long random secret (48+ characters). Generate one; do not reuse another password.
SECRET_KEY=change-me

POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

TZ=Asia/Ho_Chi_Minh
